{
  "name": "astra-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ASTRA desktop shell — Electron main process + preload (companion window, tray, shortcuts, IPC, native bridge).",
  "license": "MIT",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/ws": "^8.5.12",
    "electron": "^31.3.0",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
